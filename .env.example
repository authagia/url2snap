# HTTP
AUDIO_SOURCE_HTTP_HOST=0.0.0.0
AUDIO_SOURCE_HTTP_PORT=8000

# Playback
AUDIO_SOURCE_MPV_BIN=mpv
AUDIO_SOURCE_SNAP_FIFO=/run/snapcast/snapfifo

# Persistent state
AUDIO_SOURCE_HISTORY_FILE=./data/history.json
AUDIO_SOURCE_PLAYLIST_FILE=./data/playlists.json
AUDIO_SOURCE_QUEUE_FILE=./data/queue.json

# Error handling
AUDIO_SOURCE_ERROR_POLICY=skip
AUDIO_SOURCE_MAX_RETRIES=2
AUDIO_SOURCE_RETRY_DELAY_MS=0

# Spotify -> YouTube resolver
AUDIO_SOURCE_SPOTDL_BIN=spotdl
AUDIO_SOURCE_SPOTDL_TIMEOUT=30
